{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "preserve",
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "isolatedModules": true,
    "noEmit": true, "incremental": true, "allowJs": true,
    "plugins": [{ "name": "next" }]
  }
}
